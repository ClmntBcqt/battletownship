[Unit]
Description=BattleTownship ASP.NET Core backend
After=network.target

[Service]
Type=exec
WorkingDirectory=/srv/battletownship/backend
ExecStart=./backend
Restart=always
RestartSec=10
SyslogIdentifier=battletownship
User=battletownship
EnvironmentFile=/srv/battletownship/backend/battletownship.env

[Install]
WantedBy=multi-user.target